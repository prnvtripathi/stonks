{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stonks.local/content/glossary/schema.json",
  "title": "Stonks reviewed glossary entry",
  "type": "object",
  "required": ["slug", "term", "aliases", "summary", "interpretation", "pitfalls", "assetClasses", "sources", "reviewedAt"],
  "additionalProperties": false,
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "term": { "type": "string", "minLength": 1 },
    "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "summary": { "type": "string", "minLength": 1 },
    "formula": {
      "type": "object", "required": ["expression", "provenance"], "additionalProperties": false,
      "properties": { "expression": { "type": "string", "minLength": 1 }, "provenance": { "$ref": "#/$defs/sources" } }
    },
    "interpretation": { "type": "string", "minLength": 1 },
    "pitfalls": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "assetClasses": { "type": "array", "items": { "enum": ["equity", "etf", "mutual_fund"] } },
    "sources": { "$ref": "#/$defs/sources" },
    "reviewedAt": { "type": "string", "format": "date" }
  },
  "$defs": { "sources": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["label", "url"], "additionalProperties": false, "properties": { "label": { "type": "string", "minLength": 1 }, "url": { "type": "string", "pattern": "^(https://|/)" } } } } }
}
